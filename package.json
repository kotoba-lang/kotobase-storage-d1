{
  "private": true,
  "scripts": {
    "build": "shadow-cljs release engine r2-engine",
    "check": "shadow-cljs compile engine",
    "deploy": "npm run build && wrangler deploy",
    "dev": "npm run build && wrangler dev",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "verify:remote": "node scripts/verify.mjs",
    "benchmark": "KOTOBASE_BENCH=1 node scripts/verify.mjs",
    "slo:qualify": "node scripts/slo-qualify.mjs",
    "test:r2-backfill": "node --test test/r2-backfill-worker.test.mjs",
    "test:core": "node --test test/kotobase-core.test.mjs",
    "test:r2-authority": "shadow-cljs compile r2-contract-test && node dist/r2-contract-test.js",
    "test": "shadow-cljs compile contract-test && node dist/contract-test.js"
  },
  "devDependencies": {
    "@ipld/dag-cbor": "^9.2.1",
    "@noble/curves": "^1.7.0",
    "miniflare": "^4.20260722.1",
    "multiformats": "^13.3.1",
    "shadow-cljs": "3.4.11",
    "wrangler": "4.114.0"
  }
}
