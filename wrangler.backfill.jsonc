{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kotobase-r2-backfill-production",
  "main": "src/r2-backfill-worker.mjs",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "KOTOBASE_R2_NAMESPACE": "production",
    "KOTOBASE_R2_AUTHORITY": "d1",
    "KOTOBASE_R2_GC": "0",
    "KOTOBASE_R2_GRACE_SECONDS": "86400"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kotobase-d1-verification",
      "database_id": "6f42fbb0-20ee-4187-9435-bd71b4e264bb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "KOTOBASE_CANONICAL_R2",
      "bucket_name": "kotobase-merkle-lsm"
    }
  ]
}
