{:deps true
 :builds
 {:engine
  {:target :esm
   :output-dir "dist"
   :modules
   {:kotobase-engine
    {:entries [kotobase.storage.d1-worker]
     :exports
     {headD1 kotobase.storage.d1-worker/head-edn!
      basisD1 kotobase.storage.d1-worker/basis-edn!
      txRangeD1 kotobase.storage.d1-worker/tx-range-edn!
      listenerD1 kotobase.storage.d1-worker/listener-edn!
      adminD1 kotobase.storage.d1-worker/admin-edn!
      transactD1 kotobase.storage.d1-worker/transact-edn!
      reindexD1 kotobase.storage.d1-worker/reindex-edn!
      qD1 kotobase.storage.d1-worker/q-edn!
      pullD1 kotobase.storage.d1-worker/pull-edn!
      datomsD1 kotobase.storage.d1-worker/datoms-edn!
      foldD1 kotobase.storage.d1-worker/fold-edn!
      viewD1 kotobase.storage.d1-worker/view-edn!}}}
   :compiler-options {:optimizations :advanced
                      :source-map false}}

  :r2-engine
  {:target :esm
   :output-dir "dist"
   :modules
   {:kotobase-r2-engine
    {:entries [kotobase.storage.r2-worker]
     :exports
     {headR2 kotobase.storage.r2-worker/head-edn!
      basisR2 kotobase.storage.r2-worker/basis-edn!
      transactR2 kotobase.storage.r2-worker/transact-edn!
      qR2 kotobase.storage.r2-worker/q-edn!
      pullR2 kotobase.storage.r2-worker/pull-edn!
      datomsR2 kotobase.storage.r2-worker/datoms-edn!
      foldR2 kotobase.storage.r2-worker/fold-edn!
      viewR2 kotobase.storage.r2-worker/view-edn!
      parityR2 kotobase.storage.r2-worker/parity!}}}
   :compiler-options {:optimizations :advanced
                      :source-map false}}

  ;; Opt-in block provider (ADR-2608281000 Decision 2): blocks on a real
  ;; independently operated IPFS network, refs still on D1. Not built into
  ;; the default `engine`/`r2-engine` bundles worker.mjs already imports --
  ;; a separate module so a deployment that never sets KOTOBASE_AUTHORITY=ipfs
  ;; never ships this code path.
  :ipfs-engine
  {:target :esm
   :output-dir "dist"
   :modules
   {:kotobase-ipfs-engine
    {:entries [kotobase.storage.ipfs-worker]
     :exports
     {headIPFS kotobase.storage.ipfs-worker/head-edn!
      basisIPFS kotobase.storage.ipfs-worker/basis-edn!
      transactIPFS kotobase.storage.ipfs-worker/transact-edn!
      qIPFS kotobase.storage.ipfs-worker/q-edn!
      pullIPFS kotobase.storage.ipfs-worker/pull-edn!
      datomsIPFS kotobase.storage.ipfs-worker/datoms-edn!
      foldIPFS kotobase.storage.ipfs-worker/fold-edn!
      viewIPFS kotobase.storage.ipfs-worker/view-edn!}}}
   :compiler-options {:optimizations :advanced
                      :source-map false}}

  ;; The storage contract against a real D1 (miniflare/SQLite), including
  ;; its concurrent half. A node-script rather than a JS harness so the
  ;; test is written in the same language as the code it tests.
  :contract-test
  {:target :node-script
   :output-to "dist/contract-test.js"
   :main kotobase.storage.d1-contract-test/-main
   :compiler-options {:optimizations :none}}

  :r2-contract-test
  {:target :node-script
   :output-to "dist/r2-contract-test.js"
   :main kotobase.storage.r2-contract-test/-main
   :compiler-options {:optimizations :none}}

  :ipfs-contract-test
  {:target :node-script
   :output-to "dist/ipfs-contract-test.js"
   :main kotobase.storage.ipfs-contract-test/-main
   :compiler-options {:optimizations :none}}}}
