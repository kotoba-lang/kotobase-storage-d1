;; One ESM module that IS the Worker. This previously built a library of
;; Datomic entry points which a hand-written src/worker.mjs imported and
;; wrapped in its own hand-rolled CACAO auth; that .mjs is gone
;; (ADR-2607268000), so the compiled module exports the fetch handler directly
;; and wrangler.jsonc points `main` at it.
{:deps true
 :builds
 {:worker
  {:target :esm
   :output-dir "dist"
   :modules
   {:worker
    {:entries [kotobase.storage.d1-http]
     :exports {:default kotobase.storage.d1-http/handler}}}
   :compiler-options {:optimizations :advanced
                      :source-map false
                      ;; env.DB must survive property renaming -- see
                      ;; externs/cloudflare.js and d1-auth/db-of.
                      :externs ["externs/cloudflare.js"]}}}}
